cabal-version:      3.4
name:               lithic
version:            0.9.17.0
build-type:         Simple
license:            NONE
author:             Eric Vincent (arch)
maintainer:         eric@efvincent.com
extra-doc-files:    CHANGELOG.md
extra-source-files: src/Compiler/CGenPrelude.c

common shared
    ghc-options: -Wall 
                 -Wcompat 
    build-depends:
        base >= 4.19 && < 5,
        bluefin,
        vector,
        text,
        microlens,
        generic-lens,
        brick,
        vty,
        vty-crossplatform,
        containers,
        neat-interpolation,
        template-haskell

    default-extensions:
        BlockArguments
        LambdaCase
        OverloadedStrings
        OverloadedRecordDot
        DataKinds
        DuplicateRecordFields
        OverloadedLabels

library
    import:           shared
    exposed-modules:  Compiler.AST
                    , Compiler.AST.Core
                    , Compiler.CGen
                    , Compiler.Lexer
                    , Compiler.Parser
                    , Compiler.PatternMatch
                    , Compiler.Elaborator
                    , Compiler.Evaluator
                    , Compiler.TypeChecker
                    , Compiler.REPL
                    , Compiler.TUI
                    , Compiler.QQ
    hs-source-dirs:   src
    default-language: GHC2024

executable lithic-cli
    import:           shared
    main-is:          Main.hs
    build-depends:   lithic
                    ,filepath 
    hs-source-dirs:   app
    default-language: GHC2024
    ghc-options:      -threaded
    
test-suite lithic-test
    import:           shared
    other-modules:    Test.Golden
                    , Test.PatternCoverage
                    , Test.CGen
                    , Test.CLIEmitC
                    , Test.Elaborator
                    , Test.Evaluator
                    , Test.ParserDeclarations
                    , Test.Phase9HScaffold
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Main.hs
    build-depends:    base
                    , lithic
                    , text
                    , bytestring
                    , filepath
                    , directory
                    , process
                    , tasty
                    , tasty-golden
                    , tasty-hunit
                    , bluefin
                    , containers
    default-language: GHC2024
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N